{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hepi",
  "version": "0.20.8",
  "identifier": "com.easyapp.hepi",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hepi",
        "width": 980,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://api.hepi.help/updates/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": ""
    }
  }
}
