{
  "manifest_version": 3,
  "name": "Kizspy Helper",
  "version": "3.0",
  "description": "Helper extension for Kizspy",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://app.kizspy.me/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "scripts/*"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "lib/html2canvas.min.js",
        "lib/jszip.min.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}