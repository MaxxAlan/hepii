# Git LFS — large binary artifacts
#
# Third-party Safe Exam Browser (SEB) binaries: ~476 MB of dll/pdb/exe/pak/dat.
# Reverse-engineering evidence dumps: ~12 MB, mostly multi-MB text dumps.
# Both are stored as LFS objects; blobs in git are pointers.

sep/**       filter=lfs diff=lfs merge=lfs -text
docs/raw/**  filter=lfs diff=lfs merge=lfs -text

# Safety net for binaries committed outside the two trees above.
*.dll filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
